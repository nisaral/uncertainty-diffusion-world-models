% ---------------------------------------------------------------------------
% GROUP 4 - Epistemic uncertainty for diffusion models WITHOUT ensembles.
% These are the honest competing baselines for the whole ensemble-MC premise.
% If one model plus a Laplace pushforward gives Sigma^ep, the paper owes a
% reason to pay for N members x M samples.
% ---------------------------------------------------------------------------

@article{gupta2026flare,
  title={Quantifying Epistemic Uncertainty in Diffusion Models},
  author={Gupta, Aditi and Meyer, Raphael A. and Yaniv, Yotam and Chen, Elynn and Erichson, N. Benjamin},
  journal={arXiv:2602.09170},
  year={2026},
  note={FLARE: Fisher-Laplace randomised-subnetwork estimator. Epistemic
        covariance from ONE model, via a Laplace posterior pushed through the
        denoiser Jacobian and propagated over reverse steps -- no ensemble, no
        repeated inference-time sampling. Opens by naming our exact problem:
        "existing methods are often unreliable because they mix epistemic and
        aleatoric uncertainty". Their separation is structural (condition on a
        fixed noise realisation eta) rather than a subtraction, so they have no
        finite-M bias to correct; what they have instead is a delta-method
        linearisation, a dropped cross-covariance term, and an O(1/sqrt m)
        subsampling bound. Note their "shared stochastic reverse path" is the same
        common-random-numbers device we use to couple members, independently
        arrived at for the same reason: so claim the bias IDENTITY, never the
        shared-latent trick.}
}

@article{decu2024,
  title={Estimating Epistemic Uncertainty in Diffusion Models},
