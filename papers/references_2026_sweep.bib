@article{berger2026biaseddreams,
  title={Biased Dreams: Limitations to Epistemic Uncertainty Quantification in Latent Dynamics Models},
  author={Berger, Julia and Frauenknecht, Bernd and Trimpe, Sebastian and Leibe, Bastian},
  journal={arXiv:2604.25416},
  year={2026},
  note={SIBLING NEGATIVE RESULT, from the MACURA group. Ensemble
        geometric-Jensen-Shannon disagreement over RSSM latent rollouts SHRINKS
        toward in-distribution levels while true divergence from the simulator
        grows -- an "attractor behavior" pulling rollouts to well-supported latent
        regions -- and closed-loop prior rollouts overestimate reward
        systematically. Two DMC RSSM variants, four tasks, five seeds. States the
        limitation "cannot be resolved through improved uncertainty estimation
        alone". Their evidence is qualitative by their own description and "a
        formal characterization of the attractor mechanism" is listed as future
        work, which is exactly where a mechanism belongs.}
}

