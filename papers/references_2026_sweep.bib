@inproceedings{voelcker2022vagram,
  title={Value Gradient weighted Model-Based Reinforcement Learning},
  author={Voelcker, Claas A. and Liao, Victor and Garg, Animesh and Farahmand, Amir-massoud},
  booktitle={ICLR},
  year={2022},
  note={arXiv:2204.01464. Diagnoses the failure of value-aware model learning
        under a LEARNED critic: the loss queries the critic at the model's own
        prediction, which is off-distribution, and equal-value solutions create
        spurious minima that move whenever the critic updates, so the model
        "can get stuck or even diverge". Stabilisers used: target networks,
        95th-percentile value-gradient clipping, real/model data mixture. Direct
        precedent for this repo's online-critic negative result and for the
        lagged-critic recipe.}
}

