@article{voelcker2025cvaml,
  title={Calibrated Value-Aware Model Learning with Stochastic Environment Models},
  author={Voelcker, Claas A. and others},
  journal={arXiv:2505.22772},
  year={2025},
  note={PARTIAL COLLISION with our estimator result, and the theory that
        explains our negative result. Their Eq 3:
        E_phat[Lhat_{1,0}] = L_IterVAML + Var_phat(V(xhat)); with k model samples
        the excess scales as (1/k)Var, removed by subtracting the sample variance
        (CVAML), calibrated, requires k >= 2. Same shape as our ((N-1)/N)g/M
        correction, but for ONE model's aleatoric spread rather than cross-member
        EPISTEMIC disagreement, and inside a training loss rather than a reported
        score that is then amplified through a Bellman recursion. Their Lemmata
        1-3 prove the uncorrected loss prefers LOW-VARIANCE models: that is the
        variance-shrinkage pathology whose ensemble analogue we measure as
        uncertainty collapse. Cite as the calibration precedent; our extension is
        the epistemic object, the coupling-dependent constant, and the
        gamma^2/(1-gamma^2) downstream amplification.}
}

